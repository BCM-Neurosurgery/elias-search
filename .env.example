# Runtime environment. Use "dev" for local development or "prod" for deployed stacks.
ENVIRONMENT=dev

# DataJoint / MySQL connection used by the Django backend.
DJ_USER=your_datajoint_user
DJ_PASSWORD=your_datajoint_password
DJ_HOST=mysql.example.org
DJ_PORT=3306

# Read-only host paths mounted into the backend container.
DATALAKE_PATH=/path/to/datalake
STITCHED_PATH=/path/to/stitched

# Service URLs injected into Docker Compose services.
BACKEND_URL=http://localhost:8080
WEBSOCKET_URL=ws://localhost:8080

# Public URLs used by the Next.js client in the browser.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080
NEXT_PUBLIC_WEBSOCKET_URL=ws://localhost:8080

# Optional: set when your DataJoint setup requires filepath management.
DJ_SUPPORT_FILEPATH_MANAGEMENT=TRUE
